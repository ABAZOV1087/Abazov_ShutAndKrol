<Window x:Class="Abazov_ShutAndKrol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Abazov_ShutAndKrol"
        mc:Ignorable="d"
Title="Читай, Пиши и не спиши" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Background="#2C3E50" Grid.Column="0" Width="80" Visibility="Collapsed">
            <StackPanel Margin="0,20,0,0">

                <Button x:Name="btnCatalog" Width="50" Height="50" Margin="0,10" Click="btnCatalog_Click" Background="Transparent" BorderBrush="Transparent">

                    <Button.ToolTip>

                        <ToolTip Content="Каталог книг"/>

                    </Button.ToolTip>

                    <Image Source="https://images.icon-icons.com/1306/PNG/512/book_86162.png" Width="30" Height="30"/>

                </Button>



                <Button x:Name="btnLists" Width="50" Height="50" Margin="0,10" Click="btnLists_Click" Background="Transparent" BorderBrush="Transparent">

                    <Button.ToolTip>

                        <ToolTip Content="Списки книг"/>

                    </Button.ToolTip>

                    <Image Source="https://images.icon-icons.com/1130/PNG/512/listcircularinterfacebutton_80135.png" Width="30" Height="30"/>

                </Button>



                <Button x:Name="btnAuthor" Width="50" Height="50" Margin="0,10" Click="btnAuthor_Click" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed">

                    <Button.ToolTip>

                        <ToolTip Content="Страница автора"/>

                    </Button.ToolTip>

                    <Image Source="/Images/author.png" Width="30" Height="30"/>

                </Button>



                <Button x:Name="btnAdmin" Width="50" Height="50" Margin="0,10" Click="btnAdmin_Click" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed">

                    <Button.ToolTip>

                        <ToolTip Content="Администрирование"/>

                    </Button.ToolTip>

                    <Image Source="https://static.vecteezy.com/system/resources/previews/014/541/527/non_2x/administrator-system-icon-simple-style-vector.jpg" Width="30" Height="30"/>

                </Button>



                <Button x:Name="btnFreezeWarning" Width="50" Height="50" Margin="0,10" Click="btnFreezeWarning_Click" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed">

                    <Button.ToolTip>

                        <ToolTip Content="Предупреждение о заморозке аккаунта"/>

                    </Button.ToolTip>

                    <Image Source="https://png.pngtree.com/png-vector/20240529/ourmid/pngtree-black-square-with-melting-vector-png-image_6987950.png" Width="30" Height="30"/>

                </Button>



                <Button x:Name="btnProfile" Width="50" Height="50" Margin="0,20,0,10" Click="btnProfile_Click" Background="Transparent" BorderBrush="Transparent">

                    <Button.ToolTip>

                        <ToolTip Content="Профиль пользователя"/>

                    </Button.ToolTip>

                    <Image Source="https://w7.pngwing.com/pngs/8/36/png-transparent-man-black-illustration-computer-icons-google-account-user-profile-iconfinder-com-icons-profile-account-profile-world-wide-web.png" Width="30" Height="30"/>

                </Button>

            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>