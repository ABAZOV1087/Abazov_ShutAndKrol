<Page x:Class="Abazov_ShutAndKrol.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Abazov_ShutAndKrol.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Панель администратора" Loaded="Page_Loaded">

    <Grid Background="#F5F7FA">
        <TabControl Margin="10">

            <TabItem Header=" Входящие жалобы ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgComplaints" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="0" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                            <DataGridTextColumn Header="ID Отправителя" Binding="{Binding SenderID}" Width="100"/>
                            <DataGridTextColumn Header="ID Книги" Binding="{Binding TargetBookID}" Width="80"/>
                            <DataGridTextColumn Header="ID Отзыва" Binding="{Binding TargetReviewID}" Width="80"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right">
                        <Button x:Name="btnApproveAuthor" Content="Назначить автором" Click="btnApproveAuthor_Click" Width="180" Height="35" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0"/>
                        <Button x:Name="btnReject" Content="Отклонить жалобу" Width="150" Height="35" Background="#95A5A6" Foreground="White" BorderBrush="Transparent" Click="btnReject_Click" Margin="0,0,10,0"/>
                        <Button x:Name="btnFreezeBook" Content="🔒 Заморозить книгу" Width="160" Height="35" Background="#E67E22" Foreground="White" BorderBrush="Transparent" Click="btnFreezeBook_Click" Margin="0,0,10,0"/>
                        <Button x:Name="btnFreezeUser" Content="🚫 Заморозить автора" Width="160" Height="35" Background="#C0392B" Foreground="White" BorderBrush="Transparent" Click="btnFreezeUser_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header=" Замороженные книги ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgFrozenBooks" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="0" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                            <DataGridTextColumn Header="Название книги" Binding="{Binding Title}" Width="250"/>
                            <DataGridTextColumn Header="ID Автора" Binding="{Binding AuthorID}" Width="100"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="btnUnfreezeBook" Content="🔓 Разморозить книгу" Grid.Row="1" HorizontalAlignment="Right" Width="180" Height="35" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="btnUnfreezeBook_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header=" Замороженные пользователи ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgFrozenUsers" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="0" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                            <DataGridTextColumn Header="Отображаемое имя" Binding="{Binding DisplayName}" Width="200"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="btnUnfreezeUser" Content="✅ Разблокировать пользователя" Grid.Row="1" HorizontalAlignment="Right" Width="220" Height="35" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="btnUnfreezeUser_Click"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>