<Page x:Class="Abazov_ShutAndKrol.Pages.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Abazov_ShutAndKrol.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Детали книги" Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#FFFFFF" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button x:Name="btnBack" Content="← Назад в каталог" HorizontalAlignment="Left" Padding="10,5" Click="btnBack_Click" Background="#7F8C8D" Foreground="White" BorderBrush="Transparent"/>

            <Grid Grid.Row="1" Margin="0,20,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{Binding CoverPath}" Stretch="Uniform" MaxHeight="280" HorizontalAlignment="Left"/>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tblAuthor" FontSize="16" Foreground="Gray" Margin="0,5,0,0"/>
                    <TextBlock x:Name="tblRating" FontSize="16" FontWeight="SemiBold" Foreground="#F1C40F" Margin="0,5,0,15"/>

                    <TextBlock Text="Описание:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Description}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <Button x:Name="btnRead" Content="Читать книгу" Padding="20,10" Click="btnRead_Click" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,15,0"/>
                        <Button x:Name="btnComplainBook" Content="⚠ Пожаловаться на книгу" Padding="10,5" Click="btnComplainBook_Click" Background="#E67E22" Foreground="White" BorderBrush="Transparent" Margin="0,0,10,0"/>
                        <Button x:Name="btnComplainAuthor" Content="⚠ Пожаловаться на автора" Padding="10,5" Click="btnComplainAuthor_Click" Background="#D35400" Foreground="White" BorderBrush="Transparent" Margin="0,0,20,0"/>

                        <Button x:Name="btnAdminFreezeBook" Content="🔒 Заморозить книгу (Админ)" Padding="15,5" Click="btnAdminFreezeBook_Click" Background="#C0392B" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Visibility="Collapsed"/>
                        <TextBlock Text="Статус чтения:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                        <ComboBox x:Name="cbBookStatus" Width="150" Height="30" SelectionChanged="cbBookStatus_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Separator Margin="0,0,0,20"/>
                <TextBlock Text="Отзывы и рецензии" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <Border x:Name="borderAddReview" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,20" Background="#F8F9F9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Ваша оценка (1-10):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cbRating" Width="60" Height="25">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBox x:Name="tbReviewText" Grid.Row="1" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,10" SelectionBrush="{x:Null}"/>

                        <Button x:Name="btnSendReview" Grid.Row="2" Content="Оставить отзыв" HorizontalAlignment="Right" Padding="15,7" Click="btnSendReview_Click" Background="#3498DB" Foreground="White" BorderBrush="Transparent"/>
                    </Grid>
                </Border>

                <ListBox x:Name="lbReviews" Background="Transparent" BorderBrush="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" Margin="0,5" Padding="15" CornerRadius="6" Width="820">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" Direction="270" Opacity="0.05" ShadowDepth="1"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <WrapPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Users.DisplayName}" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,15,0"/>
                                            <TextBlock Text="Оценка: " Foreground="#F1C40F"/>
                                            <TextBlock Text="{Binding Rating}" FontWeight="Bold" Foreground="#F1C40F"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#34495E" FontSize="13"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Пожаловаться на отзыв" Click="btnComplainReview_Click" Background="Transparent" BorderBrush="Transparent" Foreground="#E74C3C" Cursor="Hand" FontSize="11" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>