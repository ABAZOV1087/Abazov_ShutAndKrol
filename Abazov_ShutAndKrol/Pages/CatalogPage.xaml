<Page x:Class="Abazov_ShutAndKrol.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Abazov_ShutAndKrol.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог книг" Loaded="Page_Loaded">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="10" VerticalAlignment="Center">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5,0"/>
            <TextBox x:Name="tbSearch" Width="180" Height="25" VerticalContentAlignment="Center" TextChanged="tbSearch_TextChanged"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="cbSort" Width="150" Height="25" SelectionChanged="cbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="По алфавиту (А-Я)"/>
                <ComboBoxItem Content="По алфавиту (Я-А)"/>
            </ComboBox>

            <TextBlock Text="Жанр:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="cbGenre" Width="150" Height="25" SelectionChanged="cbGenre_SelectionChanged"/>
        </WrapPanel>

        <ListView x:Name="lvBooks" Grid.Row="1" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="lvBooks_MouseDoubleClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Margin="10" Width="160" Height="240" Background="#FAFAFA">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Row="0" Source="{Binding CoverPath}" Stretch="UniformToFill" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <TextBlock Grid.Row="2" Text="{Binding Users.DisplayName}" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>