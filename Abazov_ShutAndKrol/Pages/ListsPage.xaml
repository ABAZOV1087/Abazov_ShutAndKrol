<Page x:Class="Abazov_ShutAndKrol.Pages.ListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Abazov_ShutAndKrol.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Мои списки книг" Loaded="Page_Loaded">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="15" VerticalAlignment="Center">
            <TextBlock Text="Категория списка:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
            <ComboBox x:Name="cbListFilter" Width="200" Height="30" SelectionChanged="cbListFilter_SelectionChanged"/>
        </WrapPanel>

        <ListView x:Name="lvUserBooks" Grid.Row="1" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="lvUserBooks_MouseDoubleClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Margin="10" Width="160" Height="260" Background="#FAFAFA">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Row="0" Source="{Binding Books.CoverPath}" Stretch="UniformToFill" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="1" Text="{Binding Books.Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <TextBlock Grid.Row="2" Text="{Binding ReadingListStatuses.Name}" FontSize="12" Foreground="#3498DB" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>