<Page x:Class="Abazov_ShutAndKrol.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Abazov_ShutAndKrol.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid Background="#F5F7FA">
        <Border Background="#FFFFFF" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.1" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Авторизация" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Логин" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <TextBox x:Name="tbLogin" Height="35" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"/>

                <TextBlock Text="Пароль" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <PasswordBox x:Name="pbPassword" Height="35" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,25"/>

                <Button x:Name="btnLogin" Content="Войти" Height="40" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="btnLogin_Click" Margin="0,0,0,15"/>

                <Button x:Name="btnGoToRegister" Content="Ещё нет аккаунта? Зарегистрироваться" Background="Transparent" BorderBrush="Transparent" Foreground="#2980B9" Cursor="Hand" Click="btnGoToRegister_Click" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
